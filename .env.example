# OpenAI. Without it the app runs on deterministic fixture replies.
OPENAI_API_KEY=
# Model chain, first choice first; the next one is tried on a rate limit, error or timeout.
# OPENAI_MODELS=gpt-6-luna,gpt-5-nano
# OPENAI_REASONING=none  # default: none (minimal on original gpt-5 models); empty omits it

# Postgres in production (Neon, Supabase…). Unset in dev: PGlite in ./.pglite
DATABASE_URL=

# 32+ random characters. Required in production.
SESSION_SECRET=

# Optional
# MONAD_RPC_URL=https://rpc.monad.xyz
# DATE_COOLDOWN_HOURS=12
# LLM_FIXTURES=1
# DEV_LOGIN=1          # dev only: POST /api/dev/login {address} to test as a real holder

# Receives 10% of every $CHOG gift (a public wallet address, not a secret). Gifts are off without it.
BUILDER_ADDRESS=
