# OpenAI. Without it, dates run on built-in fallback replies.
OPENAI_API_KEY=
# Model chain, first choice first; the next one is tried on a rate limit, error or timeout.
# Empty means the default: gpt-6-luna,gpt-5-nano
OPENAI_MODELS=
# reasoning_effort for date turns. Empty means "none" (or "minimal" on original gpt-5 models); "off" omits it.
OPENAI_REASONING=

# Postgres in production (Neon, Supabase...). Empty in dev: PGlite in ./.pglite
DATABASE_URL=

# 32+ random characters. Required in production; a dev default is used locally.
SESSION_SECRET=

# Receives 10% of every $CHOG gift (a public wallet address, not a secret). Gifts are off without it.
BUILDER_ADDRESS=

# Optional. Empty means https://rpc.monad.xyz
MONAD_RPC_URL=
# Hours between dates for a couple. Empty means 12.
DATE_COOLDOWN_HOURS=
# 1 forces the built-in fallback replies even with a key.
LLM_FIXTURES=
# 1 enables /dev in local development only: sign in as any Chog's real holder.
DEV_LOGIN=
